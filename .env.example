# RG DEVs — M-Pesa (Safaricom Daraja) configuration.
#
# PLACEHOLDERS ONLY. Never commit real values to this file or any other file.
# These are set as SERVER-SIDE secrets in the Floot project (Settings -> Resources),
# never in frontend code, and they are never logged.
#
# ---------------------------------------------------------------------------
# Daraja
# ---------------------------------------------------------------------------

# sandbox | production  — switches the API base URL and nothing else in code.
#   sandbox    -> https://sandbox.safaricom.co.ke
#   production -> https://api.safaricom.co.ke
MPESA_ENV=sandbox

# From the Daraja portal app (https://developer.safaricom.co.ke).
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Sandbox: 174379 (Safaricom's shared test shortcode).
# Production: your own Till / Paybill number.
MPESA_SHORTCODE=174379

# The Lipa Na M-Pesa Online passkey for that shortcode.
MPESA_PASSKEY=your_daraja_passkey

# A long random string we generate ourselves (NOT from Safaricom).
# Safaricom does not sign its callbacks, so this value is what proves a
# callback arrived at a URL only Safaricom was told about. Rotate it by
# changing this secret and re-registering the callback URL.
#   Generate with: openssl rand -hex 32
MPESA_CALLBACK_SECRET=generate_a_long_random_hex_string

# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------

# Neon project "rgdev-site". The app uses the main branch; the test branch is
# used only by the automated tests so they never touch real orders.
POSTGRES_CONNECTION_STRING=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Private installer access
# ---------------------------------------------------------------------------

# Fine-grained GitHub tokens with Contents: Read-only, used server-side to mint
# short-lived signed download links for private release assets. One per owner,
# because the two products live under different GitHub accounts.
GITHUB_TOKEN_KENRODGERSUTUGI_TECH=github_pat_placeholder_for_rg_dev_pos
GITHUB_TOKEN_KENRODGERS_BIT=github_pat_placeholder_for_herdly
